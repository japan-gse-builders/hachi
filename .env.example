# Non-secret settings. Secrets (Twilio, SendGrid, ...) live in Secret Manager, never here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-northeast1
RECORDINGS_BUCKET=oct1-hachi-recordings
PORT=8080
# Caller ID for outbound calls. Toll-free number for development; replace with a Japanese 050 number in production.
TWILIO_VOICE_FROM=+15005550006
# SMS sender (US local number; the toll-free voice number cannot send SMS).
TWILIO_SMS_FROM=+15005550007
# SMS destinations allowed during the MVP (Japan only).
SMS_ALLOWED_PREFIXES=+81
# Email (optional): the SendGrid key lives in Secret Manager as `sendgrid-api-key`.
EMAIL_FROM=
# Web app (apps/web/.env.local). Firebase web config is public (restricted by domain); do not put Admin SDK keys here.
# VITE_API_BASE=https://hachi-api.example.run.app
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# Family alerts on phones (optional): from the Firebase web app config and Cloud Messaging > Web Push certificates.
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
# Browser origins allowed to call the API, comma-separated.
# WEB_ORIGINS=http://localhost:5173,https://hachicall-nao.web.app
# Post-call analysis (set on Cloud Run by infra/deploy-analyzer.sh; Gemini uses the runtime service account).
# ANALYZER_BASE_URL=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global
