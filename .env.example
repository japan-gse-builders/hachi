# Non-secret settings. Secrets (Twilio, SendGrid, ...) live in Secret Manager, never here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-northeast1
RECORDINGS_BUCKET=oct1-hachi-recordings
PORT=8080
# Caller ID for outbound calls. Toll-free number for development; replace with a Japanese 050 number in production.
TWILIO_VOICE_FROM=+15005550006
# SMS sender (US local number; the toll-free voice number cannot send SMS).
TWILIO_SMS_FROM=+15005550007
# SMS destinations allowed during the MVP (Japan only).
SMS_ALLOWED_PREFIXES=+81
# Email (optional): the SendGrid key lives in Secret Manager as `sendgrid-api-key`.
EMAIL_FROM=
# Web app (apps/web/.env.local). Firebase web config is public (restricted by domain); do not put Admin SDK keys here.
# VITE_API_BASE=https://hachi-api.example.run.app
# VITE_FIREBASE_API_KEY=
# The web app's own Hosting domain (e.g. hachicall.web.app), not <project>.firebaseapp.com: the Google
# sign-in window and consent screen show it. Add https://<it>/__/auth/handler to the OAuth client.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# Family alerts on phones (optional): from the Firebase web app config and Cloud Messaging > Web Push certificates.
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
# Browser origins allowed to call the API, comma-separated. infra/deploy-api.sh derives it from the
# Hosting sites in firebase.json; the analyzer and voice gateway deploys take APP_BASE_URL from the first.
# WEB_ORIGINS=http://localhost:5173,https://hachicall.web.app
# Post-call analysis (set on Cloud Run by infra/deploy-analyzer.sh; Gemini uses the runtime service account).
# ANALYZER_BASE_URL=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global
# Monthly AI spend ceiling. Set all five on telephony, analyzer and api: they charge one ledger, and
# a price that differs between them makes the month's total mean nothing. The prices are Vertex AI
# list prices, which is what a Google Cloud spend cap counts, not the discounted price we pay —
# see docs/COST_CONTROL.md before changing any of them.
AI_MONTHLY_CAP_USD=70
AI_SPEND_STOP_FRACTION=0.9
GEMINI_LIVE_PRICE_PER_MIN=0.15
GEMINI_PRICE_IN_PER_M=1.5
GEMINI_PRICE_OUT_PER_M=7.5

# Voice gateway: optional automatic end-of-speech tuning (unset preserves Gemini defaults).
# LIVE_SILENCE_MS=2500                 # integer 500–2500 ms
# LIVE_END_OF_SPEECH_SENSITIVITY=low  # low or high
# No response: wait 2.5s, ask; wait 4s, ask; wait 5s, ask; wait 5s, flag R1.
# Every wait starts after the previous prompt has played. A reply cancels the sequence.
# SILENCE_PROMPT_INTERVALS_SEC=2.5:4:5

# Optional analytics service only; not needed by the web app or other workers.
# See docs/ANALYTICS.md. The deployment script supplies these on hachi-analytics.
# PUBLIC_BASE_URL=https://hachi-analytics-PROJECT_NUMBER.asia-northeast1.run.app
# ANALYTICS_TOPIC=hachi-call-outcomes-v1
# ANALYTICS_INVOKER_SA=hachi-analytics-scheduler@PROJECT_ID.iam.gserviceaccount.com
# ANALYTICS_ORG_IDS=your-organization-id
# ANALYTICS_INCLUDE_REAL_DATA=false
# ANALYTICS_LOOKBACK_DAYS=30
# ANALYTICS_PAGE_SIZE=100
# ANALYTICS_MAX_PAGES=5
