{
  "name": "hachi",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-hachi \"npm test\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
